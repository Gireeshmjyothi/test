DECLARE
    v_constraint_name USER_CONSTRAINTS.CONSTRAINT_NAME%TYPE;
BEGIN

    SELECT constraint_name
    INTO v_constraint_name
    FROM user_constraints
    WHERE table_name = 'PAYOUT_SCHEDULER'
      AND constraint_type = 'C'
      AND search_condition_vc LIKE '%STATUS%'
      AND search_condition_vc LIKE '%PENDING%'
      AND search_condition_vc LIKE '%IN_PROCESS%'
      AND search_condition_vc LIKE '%SUCCESS%'
      AND search_condition_vc LIKE '%FAIL%'
      AND ROWNUM = 1;

    EXECUTE IMMEDIATE
        'ALTER TABLE PAYOUT_SCHEDULER DROP CONSTRAINT '
        || v_constraint_name;

    EXECUTE IMMEDIATE
        'ALTER TABLE PAYOUT_SCHEDULER ADD CONSTRAINT '
        || v_constraint_name
        || ' CHECK (STATUS IN (''PENDING'', ''IN_PROCESS'', ''SUCCESS'', ''FAIL'', ''PARTIAL''))';

END;
/
